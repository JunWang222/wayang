FROM apache/spark:3.5.7-scala2.12-java17-python3-r-ubuntu

USER root

RUN mkdir -p /opt/wayang/lib /opt/wayang/conf
COPY .build/wayang-libs/ /opt/wayang/lib/
COPY wayang-k8s.properties /opt/wayang/conf/wayang-k8s.properties
RUN chown -R 185:0 /opt/wayang

USER 185
